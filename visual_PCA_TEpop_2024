@geno = ();
open(IN,"$ARGV[0]");
while (<IN>) {
        $_ =~ s/\"//g;
        ($sp,$v,$ch) = /^\S+\s+[^_]+_([A-Z][a-z]{3})([^_]{0,8})_\S+_chr([^_-]+)[-_]/;
        if ($sp) {
                unless ($v ~~ @var){
                        push(@var,$v);
			$species{$v} = $v;
                        print "new var $sp\t$vi\n";
                        }


		# collect (sub) genomes for chromosome display  
                ($sub) = ($ch =~ /\d+([A-Za-z]{1,2})/);
                $gen_ID = "$sp$v\_$sub";
                unless ($gen_ID ~~ @geno){
                        push(@geno,$gen_ID);
                        print "new genome $sub\t$gen_ID\n";
                        }

		# assign genome code to each TE
		($te) = /^\S+\s+(\S+)\s/;
		$genome_code{$te} = $gen_ID;

		# collect chromosome names and make accession-chr index	
		$chr_ID = "$sp$v\_$ch";
		unless ($chr_ID ~~ @chr){
			$var_ID = "$sp\_$v";
			# get rid of version numbers
			$var_ID =~ s/p1//g;
			$var_ID =~ s/v\d+$//;
                        push(@chr,$chr_ID);
			$chr_ID{$chr_ID} = $gen_ID;
			$chr_var{$chr_ID} = $var_ID;
                        print "new chr $ch\t$chr_ID\tvar=$var_ID\n";
                        }

                }


        }
close(IN);

