		$age = $min_age;
		}
	if ($age > $max_age) {
		$age = $max_age;
                }

	# calc age code	
	$age_code = int(($age-$min_age)/$age_step);
	$age_code{$te} = $age_code;

	$genome = $genome_code{$te};
